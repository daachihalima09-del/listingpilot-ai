generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  READY
  ARCHIVED
}

enum ProjectSourceType {
  RAW_SPECIFICATIONS
  SUPPLIER_URL
  PRODUCT_URL
  UPLOADED_PDF
  SHOPIFY_IMPORT
}

enum ShopifyImportLinkStatus {
  LINKED
  INCONSISTENT
}

enum ShopifyChangeReviewStatus {
  OPEN
  STALE
  PUBLISHED
}

enum ShopifyStoreStatus {
  PENDING
  CONNECTED
  ACTIVE
  DISCONNECTED
  REVOKED
}

enum ShopifyLaunchIntentStatus {
  PENDING
  WORKSPACE_SELECTED
  OAUTH_STARTED
  COMPLETED
  EXPIRED
}

enum ShopifyLaunchOrigin {
  DISTRIBUTION_INSTALL
  SHOPIFY_LAUNCH
}

enum MerchantCatalogSetupMode {
  SHOPIFY_IMPORT
  MANUAL
}

enum MerchantCatalogEntryKind {
  COLLECTION
  PRODUCT_TYPE
  VENDOR
}

enum MerchantBusinessProfileStatus {
  INCOMPLETE
  COMPLETE
  NEEDS_REVIEW
  INVALID
}

enum MerchantPreferenceSectionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  NEEDS_REVIEW
  INVALID
}

enum MerchantPreferenceValidationStatus {
  NOT_VALIDATED
  VALID
  INVALID
}

enum MerchantPreferenceSource {
  SHOPIFY_IMPORT
  MANUAL
  MERCHANT_EDIT
  PLATFORM_DEFAULT
}

enum ShopifyProductPublicationStatus {
  ACTIVE
  DRAFT
}

enum ShopifyImageSourceType {
  REMOTE_URL
  LOCAL_UPLOAD
}

enum ShopifyImageStatus {
  CONFIGURED
  UPLOADING
  PROCESSING
  READY
  FAILED
  MISSING_REMOTE
  INACTIVE
}

enum ShopifyImageUploadSessionStatus {
  PENDING
  PROCESSING
  CONSUMED
}

enum ShopifyPublicationExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  UNCHANGED
  PARTIAL
  PENDING
  FAILED
  CANCELLED
}

enum ShopifyPublicationTriggerType {
  MANUAL_FULL
  MANUAL_RETRY
  REFRESH_PENDING
}

enum ShopifyPublicationStep {
  PRODUCT
  VARIANTS
  METAFIELDS
  IMAGES
}

enum ShopifyPublicationStepStatus {
  NOT_STARTED
  RUNNING
  SUCCEEDED
  UNCHANGED
  SKIPPED
  PENDING
  PARTIAL
  FAILED
  BLOCKED
}

model User {
  id                           String                        @id @default(uuid()) @db.Uuid
  email                        String                        @unique @db.VarChar(320)
  emailVerified                DateTime?                     @map("email_verified")
  passwordHash                 String?                       @map("password_hash") @db.Text
  name                         String?                       @db.VarChar(200)
  image                        String?                       @db.Text
  status                       UserStatus                    @default(ACTIVE)
  lastLoginAt                  DateTime?                     @map("last_login_at")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  accounts                     Account[]
  sessions                     Session[]
  memberships                  Membership[]
  auditLogs                    AuditLog[]
  shopifyOAuthStates           ShopifyOAuthState[]
  shopifyLaunchIntents         ShopifyLaunchIntent[]
  shopifyImageUploadSessions   ShopifyImageUploadSession[]
  shopifyPublicationExecutions ShopifyPublicationExecution[]
  shopifyChangeReviews         ShopifyChangeReview[]

  @@index([status])
  @@map("users")
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  slug        String       @unique @db.VarChar(100)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  workspaces  Workspace[]
  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Workspace {
  id                      String                   @id @default(uuid()) @db.Uuid
  organizationId          String                   @map("organization_id") @db.Uuid
  name                    String                   @db.VarChar(200)
  slug                    String                   @db.VarChar(100)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs               AuditLog[]
  projects                Project[]
  shopifyStores           ShopifyStore[]
  shopifyOAuthStates      ShopifyOAuthState[]
  shopifyLaunchIntents    ShopifyLaunchIntent[]
  merchantCatalogProfile  MerchantCatalogProfile?
  merchantBusinessProfile MerchantBusinessProfile?

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model MerchantBusinessProfile {
  id                     String                        @id @default(uuid()) @db.Uuid
  workspaceId            String                        @unique @map("workspace_id") @db.Uuid
  version                Int                           @default(1)
  status                 MerchantBusinessProfileStatus @default(INCOMPLETE)
  lastCompletedSectionId String?                       @map("last_completed_section_id") @db.VarChar(50)
  fingerprint            String                        @db.Char(64)
  metadata               Json                          @default("{}") @db.JsonB
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  workspace              Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections               MerchantPreferenceSection[]

  @@unique([id, workspaceId])
  @@index([status])
  @@index([updatedAt])
  @@map("merchant_business_profiles")
}

model MerchantPreferenceSection {
  id                String                             @id @default(uuid()) @db.Uuid
  businessProfileId String                             @map("business_profile_id") @db.Uuid
  workspaceId       String                             @map("workspace_id") @db.Uuid
  sectionId         String                             @map("section_id") @db.VarChar(50)
  schemaVersion     Int                                @map("schema_version")
  version           Int                                @default(1)
  status            MerchantPreferenceSectionStatus
  validationStatus  MerchantPreferenceValidationStatus @map("validation_status")
  source            MerchantPreferenceSource
  payload           Json                               @db.JsonB
  fingerprint       String                             @db.Char(64)
  metadata          Json                               @default("{}") @db.JsonB
  completedAt       DateTime?                          @map("completed_at")
  createdAt         DateTime                           @default(now()) @map("created_at")
  updatedAt         DateTime                           @updatedAt @map("updated_at")
  businessProfile   MerchantBusinessProfile            @relation(fields: [businessProfileId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, sectionId])
  @@unique([businessProfileId, sectionId])
  @@index([businessProfileId, status])
  @@index([workspaceId, status])
  @@index([sectionId, schemaVersion])
  @@map("merchant_preference_sections")
}

model MerchantCatalogProfile {
  id          String                   @id @default(uuid()) @db.Uuid
  workspaceId String                   @unique @map("workspace_id") @db.Uuid
  setupMode   MerchantCatalogSetupMode @map("setup_mode")
  version     Int                      @default(1)
  completedAt DateTime                 @default(now()) @map("completed_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries     MerchantCatalogEntry[]

  @@index([completedAt])
  @@map("merchant_catalog_profiles")
}

model MerchantCatalogEntry {
  id              String                   @id @default(uuid()) @db.Uuid
  profileId       String                   @map("profile_id") @db.Uuid
  kind            MerchantCatalogEntryKind
  value           String                   @db.VarChar(255)
  normalizedValue String                   @map("normalized_value") @db.VarChar(255)
  position        Int
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  profile         MerchantCatalogProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, normalizedValue])
  @@unique([profileId, kind, position])
  @@index([profileId, kind])
  @@map("merchant_catalog_entries")
}

model Project {
  id                            String                         @id @default(uuid()) @db.Uuid
  workspaceId                   String                         @map("workspace_id") @db.Uuid
  name                          String                         @db.VarChar(200)
  status                        ProjectStatus                  @default(DRAFT)
  statusBeforeArchive           ProjectStatus?                 @map("status_before_archive")
  sourceType                    ProjectSourceType?             @map("source_type")
  sourceUrl                     String?                        @map("source_url") @db.Text
  rawInput                      String?                        @map("raw_input") @db.Text
  analysisData                  Json?                          @map("analysis_data") @db.JsonB
  generatedListing              Json?                          @map("generated_listing") @db.JsonB
  seoData                       Json?                          @map("seo_data") @db.JsonB
  readinessData                 Json?                          @map("readiness_data") @db.JsonB
  version                       Int                            @default(1)
  archivedAt                    DateTime?                      @map("archived_at")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  workspace                     Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shopifyProductPublication     ShopifyProductPublication?
  shopifyVariantConfiguration   ShopifyVariantConfiguration?
  shopifyMetafieldConfiguration ShopifyMetafieldConfiguration?
  shopifyImageConfiguration     ShopifyImageConfiguration?
  shopifyImageUploadSessions    ShopifyImageUploadSession[]
  shopifyPublicationExecutions  ShopifyPublicationExecution[]
  shopifyProductImportLink      ShopifyProductImportLink?
  shopifyChangeReviews          ShopifyChangeReview[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
  @@index([archivedAt])
  @@map("projects")
}

model ShopifyVariantConfiguration {
  id          String                  @id @default(uuid()) @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  version     Int                     @default(1)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  project     Project                 @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  options     ShopifyProjectOption[]
  variants    ShopifyProjectVariant[]

  @@unique([projectId, workspaceId])
  @@index([workspaceId])
  @@map("shopify_variant_configurations")
}

model ShopifyProjectOption {
  id              String                      @id @default(uuid()) @db.Uuid
  configurationId String                      @map("configuration_id") @db.Uuid
  name            String                      @db.VarChar(255)
  position        Int
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  configuration   ShopifyVariantConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  values          ShopifyProjectOptionValue[]

  @@unique([configurationId, position])
  @@index([configurationId])
  @@map("shopify_project_options")
}

model ShopifyProjectOptionValue {
  id        String               @id @default(uuid()) @db.Uuid
  optionId  String               @map("option_id") @db.Uuid
  value     String               @db.VarChar(255)
  position  Int
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  option    ShopifyProjectOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, position])
  @@index([optionId])
  @@map("shopify_project_option_values")
}

model ShopifyProjectVariant {
  id               String                      @id @default(uuid()) @db.Uuid
  configurationId  String                      @map("configuration_id") @db.Uuid
  shopifyVariantId String?                     @unique @map("shopify_variant_id") @db.VarChar(20)
  combinationKey   String                      @map("combination_key") @db.VarChar(1024)
  optionValues     Json                        @map("option_values") @db.JsonB
  price            String                      @db.VarChar(32)
  compareAtPrice   String?                     @map("compare_at_price") @db.VarChar(32)
  sku              String?                     @db.VarChar(255)
  barcode          String?                     @db.VarChar(255)
  position         Int
  active           Boolean                     @default(true)
  firstPublishedAt DateTime?                   @map("first_published_at")
  lastPublishedAt  DateTime?                   @map("last_published_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  configuration    ShopifyVariantConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, combinationKey])
  @@index([configurationId, active, position])
  @@map("shopify_project_variants")
}

model ShopifyProductPublication {
  id               String                          @id @default(uuid()) @db.Uuid
  projectId        String                          @map("project_id") @db.Uuid
  workspaceId      String                          @map("workspace_id") @db.Uuid
  shopifyProductId String                          @map("shopify_product_id") @db.VarChar(20)
  shopifyHandle    String?                         @map("shopify_handle") @db.VarChar(255)
  shopifyTitle     String                          @map("shopify_title") @db.VarChar(255)
  lastStatus       ShopifyProductPublicationStatus @map("last_status")
  firstPublishedAt DateTime                        @default(now()) @map("first_published_at")
  lastPublishedAt  DateTime                        @default(now()) @map("last_published_at")
  createdAt        DateTime                        @default(now()) @map("created_at")
  updatedAt        DateTime                        @updatedAt @map("updated_at")
  project          Project                         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([projectId, workspaceId])
  @@unique([workspaceId, shopifyProductId])
  @@index([workspaceId, lastPublishedAt])
  @@map("shopify_product_publications")
}

model ShopifyMetafieldConfiguration {
  id            String                    @id @default(uuid()) @db.Uuid
  projectId     String                    @map("project_id") @db.Uuid
  workspaceId   String                    @map("workspace_id") @db.Uuid
  schemaVersion String                    @map("schema_version") @db.VarChar(20)
  version       Int                       @default(1)
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  project       Project                   @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  metafields    ShopifyProjectMetafield[]

  @@unique([projectId, workspaceId])
  @@index([workspaceId])
  @@map("shopify_metafield_configurations")
}

model ShopifyProjectMetafield {
  id                 String                        @id @default(uuid()) @db.Uuid
  configurationId    String                        @map("configuration_id") @db.Uuid
  catalogKey         String                        @map("catalog_key") @db.VarChar(100)
  namespace          String                        @db.VarChar(255)
  key                String                        @db.VarChar(64)
  type               String                        @db.VarChar(100)
  serializedValue    String?                       @map("serialized_value") @db.Text
  valueHash          String?                       @map("value_hash") @db.Char(64)
  enabled            Boolean                       @default(true)
  shopifyMetafieldId String?                       @map("shopify_metafield_id") @db.VarChar(20)
  firstPublishedAt   DateTime?                     @map("first_published_at")
  lastPublishedAt    DateTime?                     @map("last_published_at")
  lastPublishedHash  String?                       @map("last_published_hash") @db.Char(64)
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")
  configuration      ShopifyMetafieldConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, catalogKey])
  @@unique([configurationId, namespace, key])
  @@index([configurationId, enabled])
  @@map("shopify_project_metafields")
}

model ShopifyStore {
  id                       String                           @id @default(uuid()) @db.Uuid
  workspaceId              String                           @unique @map("workspace_id") @db.Uuid
  shopDomain               String                           @unique @map("shop_domain") @db.VarChar(255)
  shopName                 String?                          @map("shop_name") @db.VarChar(255)
  accessTokenEncrypted     String?                          @map("access_token_encrypted") @db.Text
  requestedScopes          String[]                         @default([]) @map("requested_scopes")
  grantedScopes            String[]                         @default([]) @map("scopes")
  status                   ShopifyStoreStatus               @default(PENDING)
  installedAt              DateTime?                        @map("installed_at")
  lastVerifiedAt           DateTime?                        @map("last_verified_at")
  disconnectedAt           DateTime?                        @map("disconnected_at")
  createdAt                DateTime                         @default(now()) @map("created_at")
  updatedAt                DateTime                         @updatedAt @map("updated_at")
  workspace                Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metafieldDefinitionLinks ShopifyMetafieldDefinitionLink[]
  publicationExecutions    ShopifyPublicationExecution[]
  productImportLinks       ShopifyProductImportLink[]
  changeReviews            ShopifyChangeReview[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([status])
  @@map("shopify_stores")
}

model ShopifyMetafieldDefinitionLink {
  id                  String       @id @default(uuid()) @db.Uuid
  shopifyStoreId      String       @map("shopify_store_id") @db.Uuid
  catalogKey          String       @map("catalog_key") @db.VarChar(100)
  namespace           String       @db.VarChar(255)
  key                 String       @db.VarChar(64)
  type                String       @db.VarChar(100)
  shopifyDefinitionId String       @map("shopify_definition_id") @db.VarChar(20)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  shopifyStore        ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)

  @@unique([shopifyStoreId, catalogKey])
  @@unique([shopifyStoreId, namespace, key])
  @@index([shopifyStoreId])
  @@map("shopify_metafield_definition_links")
}

model ShopifyProductImportLink {
  id                       String                  @id @default(uuid()) @db.Uuid
  projectId                String                  @unique @map("project_id") @db.Uuid
  workspaceId              String                  @map("workspace_id") @db.Uuid
  shopifyStoreId           String                  @map("shopify_store_id") @db.Uuid
  shopifyProductGid        String                  @map("shopify_product_gid") @db.VarChar(255)
  shopifyProductLegacyId   String                  @map("shopify_product_legacy_id") @db.VarChar(20)
  productHandle            String?                 @map("product_handle") @db.VarChar(255)
  status                   ShopifyImportLinkStatus @default(LINKED)
  sourceSnapshot           Json                    @map("source_snapshot") @db.JsonB
  shopifyUpdatedAtAtImport DateTime                @map("shopify_updated_at_at_import")
  importedAt               DateTime                @default(now()) @map("imported_at")
  lastSourceReadAt         DateTime                @map("last_source_read_at")
  project                  Project                 @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  shopifyStore             ShopifyStore            @relation(fields: [shopifyStoreId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, shopifyStoreId, shopifyProductGid])
  @@unique([projectId, workspaceId])
  @@index([workspaceId, shopifyProductGid])
  @@index([shopifyStoreId, shopifyProductGid])
  @@index([workspaceId, status])
  @@map("shopify_product_import_links")
}

model ShopifyChangeReview {
  id                   String                    @id @default(uuid()) @db.Uuid
  projectId            String                    @map("project_id") @db.Uuid
  workspaceId          String                    @map("workspace_id") @db.Uuid
  shopifyStoreId       String                    @map("shopify_store_id") @db.Uuid
  createdByUserId      String                    @map("created_by_user_id") @db.Uuid
  shopifyProductGid    String                    @map("shopify_product_gid") @db.VarChar(255)
  status               ShopifyChangeReviewStatus @default(OPEN)
  comparisonJson       Json                      @map("comparison_json") @db.JsonB
  decisionsJson        Json                      @default("{}") @map("decisions_json") @db.JsonB
  baselineUpdatedAt    DateTime                  @map("baseline_updated_at")
  remoteUpdatedAt      DateTime                  @map("remote_updated_at")
  remoteFingerprint    String                    @map("remote_fingerprint") @db.Char(64)
  projectVersion       Int                       @map("project_version")
  baselineSnapshotHash String                    @map("baseline_snapshot_hash") @db.Char(64)
  generatedAt          DateTime                  @default(now()) @map("generated_at")
  expiresAt            DateTime                  @map("expires_at")
  publishedAt          DateTime?                 @map("published_at")
  version              Int                       @default(1)
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  project              Project                   @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  shopifyStore         ShopifyStore              @relation(fields: [shopifyStoreId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdByUser        User                      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@index([projectId, workspaceId, generatedAt])
  @@index([workspaceId, status, generatedAt])
  @@index([shopifyStoreId, shopifyProductGid])
  @@index([status, expiresAt])
  @@index([id, version])
  @@map("shopify_change_reviews")
}

model ShopifyImageConfiguration {
  id          String                @id @default(uuid()) @db.Uuid
  projectId   String                @map("project_id") @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  version     Int                   @default(1)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  project     Project               @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  images      ShopifyProjectImage[]

  @@unique([projectId, workspaceId])
  @@index([workspaceId])
  @@map("shopify_image_configurations")
}

model ShopifyProjectImage {
  id                String                    @id @default(uuid()) @db.Uuid
  configurationId   String                    @map("configuration_id") @db.Uuid
  sourceType        ShopifyImageSourceType    @map("source_type")
  sourceUrl         String?                   @map("source_url") @db.Text
  originalFilename  String?                   @map("original_filename") @db.VarChar(255)
  mimeType          String                    @map("mime_type") @db.VarChar(50)
  byteSize          Int                       @map("byte_size")
  contentHash       String                    @map("content_hash") @db.Char(64)
  altText           String?                   @map("alt_text") @db.VarChar(512)
  position          Int
  isPrimary         Boolean                   @default(false) @map("is_primary")
  active            Boolean                   @default(true)
  status            ShopifyImageStatus        @default(CONFIGURED)
  shopifyMediaId    String?                   @map("shopify_media_id") @db.VarChar(20)
  shopifyFileId     String?                   @unique @map("shopify_file_id") @db.VarChar(20)
  shopifyImageUrl   String?                   @map("shopify_image_url") @db.Text
  firstPublishedAt  DateTime?                 @map("first_published_at")
  lastPublishedAt   DateTime?                 @map("last_published_at")
  lastErrorCategory String?                   @map("last_error_category") @db.VarChar(100)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  configuration     ShopifyImageConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, position])
  @@unique([configurationId, contentHash])
  @@index([configurationId, active, position])
  @@index([configurationId, status])
  @@map("shopify_project_images")
}

model ShopifyImageUploadSession {
  id               String                          @id @default(uuid()) @db.Uuid
  projectId        String                          @map("project_id") @db.Uuid
  workspaceId      String                          @map("workspace_id") @db.Uuid
  userId           String                          @map("user_id") @db.Uuid
  originalFilename String                          @map("original_filename") @db.VarChar(255)
  mimeType         String                          @map("mime_type") @db.VarChar(50)
  byteSize         Int                             @map("byte_size")
  altText          String?                         @map("alt_text") @db.VarChar(512)
  status           ShopifyImageUploadSessionStatus @default(PENDING)
  expiresAt        DateTime                        @map("expires_at")
  consumedAt       DateTime?                       @map("consumed_at")
  createdAt        DateTime                        @default(now()) @map("created_at")
  project          Project                         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  user             User                            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, workspaceId, userId])
  @@index([expiresAt, status])
  @@map("shopify_image_upload_sessions")
}

model ShopifyPublicationExecution {
  id                   String                            @id @default(uuid()) @db.Uuid
  projectId            String                            @map("project_id") @db.Uuid
  workspaceId          String                            @map("workspace_id") @db.Uuid
  shopifyStoreId       String                            @map("shopify_store_id") @db.Uuid
  requestedByUserId    String                            @map("requested_by_user_id") @db.Uuid
  status               ShopifyPublicationExecutionStatus @default(QUEUED)
  triggerType          ShopifyPublicationTriggerType     @map("trigger_type")
  executionNumber      Int                               @map("execution_number")
  activeLeaseProjectId String?                           @unique @map("active_lease_project_id") @db.Uuid
  startedAt            DateTime                          @default(now()) @map("started_at")
  completedAt          DateTime?                         @map("completed_at")
  lastHeartbeatAt      DateTime                          @default(now()) @map("last_heartbeat_at")
  createdAt            DateTime                          @default(now()) @map("created_at")
  updatedAt            DateTime                          @updatedAt @map("updated_at")
  project              Project                           @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  shopifyStore         ShopifyStore                      @relation(fields: [shopifyStoreId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  requestedByUser      User                              @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  steps                ShopifyPublicationStepExecution[]

  @@unique([projectId, executionNumber])
  @@index([projectId, createdAt])
  @@index([workspaceId, status])
  @@index([shopifyStoreId])
  @@map("shopify_publication_executions")
}

model ShopifyPublicationStepExecution {
  id                String                       @id @default(uuid()) @db.Uuid
  executionId       String                       @map("execution_id") @db.Uuid
  step              ShopifyPublicationStep
  status            ShopifyPublicationStepStatus @default(NOT_STARTED)
  attemptNumber     Int                          @default(0) @map("attempt_number")
  startedAt         DateTime?                    @map("started_at")
  completedAt       DateTime?                    @map("completed_at")
  retryable         Boolean                      @default(false)
  blocking          Boolean                      @default(false)
  safeErrorCategory String?                      @map("safe_error_category") @db.VarChar(100)
  safeMessage       String?                      @map("safe_message") @db.VarChar(500)
  resultSummary     Json?                        @map("result_summary") @db.JsonB
  freshnessKey      String?                      @map("freshness_key") @db.VarChar(200)
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  execution         ShopifyPublicationExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, step])
  @@index([executionId, status])
  @@map("shopify_publication_step_executions")
}

model ShopifyOAuthState {
  id             String               @id @default(uuid()) @db.Uuid
  stateHash      String               @unique @map("state_hash") @db.Char(64)
  userId         String               @map("user_id") @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  launchIntentId String?              @map("launch_intent_id") @db.Uuid
  shopDomain     String               @map("shop_domain") @db.VarChar(255)
  expiresAt      DateTime             @map("expires_at")
  consumedAt     DateTime?            @map("consumed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  launchIntent   ShopifyLaunchIntent? @relation(fields: [launchIntentId], references: [id], onDelete: SetNull)

  @@index([userId, workspaceId])
  @@index([launchIntentId])
  @@index([expiresAt])
  @@map("shopify_oauth_states")
}

model ShopifyLaunchIntent {
  id                   String                    @id @default(uuid()) @db.Uuid
  nonceHash            String                    @unique @map("nonce_hash") @db.Char(64)
  shopDomain           String                    @map("shop_domain") @db.VarChar(255)
  origin               ShopifyLaunchOrigin
  status               ShopifyLaunchIntentStatus @default(PENDING)
  requestedWorkspaceId String?                   @map("requested_workspace_id") @db.Uuid
  selectedByUserId     String?                   @map("selected_by_user_id") @db.Uuid
  safeReturnPath       String?                   @map("safe_return_path") @db.VarChar(2048)
  expiresAt            DateTime                  @map("expires_at")
  consumedAt           DateTime?                 @map("consumed_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  requestedWorkspace   Workspace?                @relation(fields: [requestedWorkspaceId], references: [id], onDelete: SetNull)
  selectedByUser       User?                     @relation(fields: [selectedByUserId], references: [id], onDelete: SetNull)
  oauthStates          ShopifyOAuthState[]

  @@index([shopDomain, status])
  @@index([expiresAt, status])
  @@index([requestedWorkspaceId])
  @@index([selectedByUserId])
  @@map("shopify_launch_intents")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Account {
  id                       String  @id @default(uuid()) @db.Uuid
  userId                   String  @map("user_id") @db.Uuid
  type                     String  @db.VarChar(50)
  provider                 String  @db.VarChar(100)
  providerAccountId        String  @map("provider_account_id") @db.VarChar(255)
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String? @db.VarChar(50)
  scope                    String? @db.Text
  id_token                 String? @db.Text
  session_state            String? @db.VarChar(255)
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(320)
  token      String   @db.VarChar(255)
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  workspaceId    String?       @map("workspace_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  action         String        @db.VarChar(150)
  entityType     String?       @map("entity_type") @db.VarChar(100)
  entityId       String?       @map("entity_id") @db.VarChar(255)
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  metadata       Json?         @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
