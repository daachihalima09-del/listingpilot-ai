generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  READY
  ARCHIVED
}

enum ProjectSourceType {
  RAW_SPECIFICATIONS
  SUPPLIER_URL
  PRODUCT_URL
  UPLOADED_PDF
}

enum ShopifyStoreStatus {
  PENDING
  CONNECTED
  ACTIVE
  DISCONNECTED
  REVOKED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(320)
  emailVerified      DateTime?           @map("email_verified")
  passwordHash       String?             @map("password_hash") @db.Text
  name               String?             @db.VarChar(200)
  image              String?             @db.Text
  status             UserStatus          @default(ACTIVE)
  lastLoginAt        DateTime?           @map("last_login_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  auditLogs          AuditLog[]
  shopifyOAuthStates ShopifyOAuthState[]

  @@index([status])
  @@map("users")
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  slug        String       @unique @db.VarChar(100)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  workspaces  Workspace[]
  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Workspace {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  name               String              @db.VarChar(200)
  slug               String              @db.VarChar(100)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs          AuditLog[]
  projects           Project[]
  shopifyStores      ShopifyStore[]
  shopifyOAuthStates ShopifyOAuthState[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model Project {
  id                  String             @id @default(uuid()) @db.Uuid
  workspaceId         String             @map("workspace_id") @db.Uuid
  name                String             @db.VarChar(200)
  status              ProjectStatus      @default(DRAFT)
  statusBeforeArchive ProjectStatus?     @map("status_before_archive")
  sourceType          ProjectSourceType? @map("source_type")
  sourceUrl           String?            @map("source_url") @db.Text
  rawInput            String?            @map("raw_input") @db.Text
  analysisData        Json?              @map("analysis_data") @db.JsonB
  generatedListing    Json?              @map("generated_listing") @db.JsonB
  seoData             Json?              @map("seo_data") @db.JsonB
  readinessData       Json?              @map("readiness_data") @db.JsonB
  version             Int                @default(1)
  archivedAt          DateTime?          @map("archived_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
  @@index([archivedAt])
  @@map("projects")
}

model ShopifyStore {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @unique @map("workspace_id") @db.Uuid
  shopDomain           String             @unique @map("shop_domain") @db.VarChar(255)
  shopName             String?            @map("shop_name") @db.VarChar(255)
  accessTokenEncrypted String?            @map("access_token_encrypted") @db.Text
  requestedScopes      String[]           @default([]) @map("requested_scopes")
  grantedScopes        String[]           @default([]) @map("scopes")
  status               ShopifyStoreStatus @default(PENDING)
  installedAt          DateTime?          @map("installed_at")
  lastVerifiedAt       DateTime?          @map("last_verified_at")
  disconnectedAt       DateTime?          @map("disconnected_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([status])
  @@map("shopify_stores")
}

model ShopifyOAuthState {
  id          String    @id @default(uuid()) @db.Uuid
  stateHash   String    @unique @map("state_hash") @db.Char(64)
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  shopDomain  String    @map("shop_domain") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
  @@index([expiresAt])
  @@map("shopify_oauth_states")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Account {
  id                       String  @id @default(uuid()) @db.Uuid
  userId                   String  @map("user_id") @db.Uuid
  type                     String  @db.VarChar(50)
  provider                 String  @db.VarChar(100)
  providerAccountId        String  @map("provider_account_id") @db.VarChar(255)
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String? @db.VarChar(50)
  scope                    String? @db.Text
  id_token                 String? @db.Text
  session_state            String? @db.VarChar(255)
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(320)
  token      String   @db.VarChar(255)
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  workspaceId    String?       @map("workspace_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  action         String        @db.VarChar(150)
  entityType     String?       @map("entity_type") @db.VarChar(100)
  entityId       String?       @map("entity_id") @db.VarChar(255)
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  metadata       Json?         @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
